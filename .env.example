PORT=3000

# Shared infra from ecommerce-infra (docker compose up -d)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=orders_user
DB_PASSWORD=orders_pass
DB_NAME=orders

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ecommerce-orders
KAFKA_GROUP_ID=ecommerce-orders-consumer
# Bounded Kafka latency: a publish to an unreachable broker gives up within ~3 s and the event
# is dead-lettered. The service starts even when Kafka is down.
KAFKA_CONNECTION_TIMEOUT_MS=1000
KAFKA_PRODUCER_RETRIES=1

# Payment events consumer (US-04)
KAFKA_CONSUMER_ENABLED=true
PAYMENT_CONSUMER_MAX_ATTEMPTS=5
PAYMENT_CONSUMER_BACKOFF_INITIAL_MS=1000
PAYMENT_CONSUMER_BACKOFF_MAX_MS=30000

# Read model (US-05)
MONGO_URI=mongodb://mongo_user:mongo_pass@localhost:27017/orders_read?authSource=admin
KAFKA_PROJECTION_GROUP_ID=ecommerce-orders-projection

# Dead-letter retry (US-08)
DEAD_LETTER_RETRY_ENABLED=true
DEAD_LETTER_RETRY_INTERVAL_MS=30000
DEAD_LETTER_BATCH_SIZE=20
DEAD_LETTER_BASE_DELAY_MS=5000
DEAD_LETTER_MAX_DELAY_MS=600000
DEAD_LETTER_MAX_RETRIES=8
