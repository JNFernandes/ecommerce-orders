PORT=3000

# Shared infra from ecommerce-infra (docker compose up -d)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=orders_user
DB_PASSWORD=orders_pass
DB_NAME=orders

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ecommerce-orders
KAFKA_GROUP_ID=ecommerce-orders-consumer

# Payment events consumer (US-04)
KAFKA_CONSUMER_ENABLED=true
PAYMENT_CONSUMER_MAX_ATTEMPTS=5
PAYMENT_CONSUMER_BACKOFF_INITIAL_MS=1000
PAYMENT_CONSUMER_BACKOFF_MAX_MS=30000
